pipeline {
    agent any

    stages {
        stage('Build') {
            steps {
                sh 'docker build -t jenkins-task2:latest .'
            }
        }

        stage('Test') {
            steps {
                sh 'docker run --rm jenkins-task2:latest test -f /usr/share/nginx/html/index.html'
            }
        }

        stage('Deploy') {
            steps {
                sh 'docker rm -f jenkins-task2-app || true'
                sh 'docker run -d --name jenkins-task2-app -p 8081:80 jenkins-task2:latest'
            }
        }
    }
}
